# Keep UART driver available (uart20 in devicetree), but it is not the console
CONFIG_SERIAL=y

# Console routed to SEGGER RTT over J-Link (no UART pins needed)
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=n
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y

# Enable MPU
CONFIG_ARM_MPU=y

# Start the GRTC syscounter (kernel timer); nothing else in this
# single-image build does it, so k_sleep/k_msleep would hang forever
# waiting on a counter that never ticks without this.
CONFIG_NRF_GRTC_START_SYSCOUNTER=y
